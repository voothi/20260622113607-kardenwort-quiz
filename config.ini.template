[Leitner]
# Repetition intervals for each box level (m = minutes, h = hours, d = days)
# The number of entries here dynamically defines the number of boxes.
intervals = 5m, 1h, 1d, 3d, 7d

# Max new cards introduced per quiz session.
# Set to -1 to disable the limit and load all new cards.
new_cards_per_day = -1

# Study ahead when no cards are due (true/false)
# - false: If no cards are due, print a summary and exit (default).
# - true: If no cards are due, let the user study cards ahead of schedule.
study_ahead = false

# Penalty for incorrect answers (reset / decrease)
# - reset: Drop progress all the way back to Box 1 (default).
# - decrease: Drop progress down by one box level.
incorrect_penalty = reset

# Serving order of new cards vs. due reviews (review_first / new_first / mix)
# - review_first: Show due reviews before new cards (default).
# - new_first: Show new cards before due reviews.
# - mix: Shuffle/interleave due reviews and new cards together.
new_review_order = review_first

# Sort order for due reviews (due_date / order_added / random)
# - due_date: Sort by box level ascending and due date (most overdue first - default).
# - order_added: Present in the sequential order they appear in the TSV file.
# - random: Shuffle due reviews randomly.
review_sort_order = due_date

# Sort order for new cards (order_added / random)
# - order_added: Present in the sequential order they appear in the TSV file (default).
# - random: Shuffle new cards randomly.
new_sort_order = order_added

# Enable flashcard mode (true/false)
# - true: Clear terminal screen and show cards in Front/Back stages.
# - false: Scroll normally in the terminal (default).
single_card_mode = true

# Enable command mode (vim-style) (true/false)
# - true: Esc toggles between answer and command prompts. Commands can be executed without typing '/'.
# - false: Normal behavior (default).
command_mode = true

# Start in command mode (true/false)
# - true: New cards start in command mode by default.
# - false: New cards start in answer prompt by default.
start_in_command_mode = true

# Esc toggles modes (true/false)
# - true: Pressing Esc in command mode toggles back to answer prompt (default).
# - false: Pressing Esc in command mode skips the card.
command_mode_esc_toggles = true

# Save input on mode switch (true/false)
# - true: When switching from answer to command prompt with Esc, saves the typed text and restores it when returning.
# - false: Typed text is discarded on mode switch (default).
command_mode_save_input = true

# Save command input on mode switch (true/false)
# - true: When switching from command prompt to answer with Esc or Enter, saves the typed command text and restores it when returning.
# - false: Typed command text is discarded on mode switch (default).
command_mode_save_command = true

# Single-key commands (true/false)
# - true: In command mode, single keystrokes (a, d, ?, q, h) execute immediately without pressing Enter.
# - false: In command mode, you must type the command and press Enter (default).
command_mode_single_key = true

# Enable keyboard arrow hints in command mode (true, swap, false)
# When in Command mode, use arrow keys to dynamically reveal letters and words.
# - true: Default hint mapping.
#         Left arrow reveals from the end. Right arrow reveals from the start.
#         Up arrow reveals from the middle. Down arrow hides and resets the hints.
# - swap: Inverted hint mapping.
#         Left arrow reveals from the start. Right arrow reveals from the end.
#         Up arrow hides and resets the hints. Down arrow reveals from the middle.
# - false: Arrow keys behave normally in the terminal. Hints are disabled (default).
command_mode_arrow_hints = true

# Enable keyboard arrow hints in answer mode (true, swap, false)
# When in Answer mode, use arrow keys to dynamically reveal letters and words.
# - true: Default hint mapping.
#         Left arrow reveals from the end. Right arrow reveals from the start.
#         Up arrow reveals from the middle. Down arrow hides and resets the hints.
# - swap: Inverted hint mapping.
#         Left arrow reveals from the start. Right arrow reveals from the end.
#         Up arrow hides and resets the hints. Down arrow reveals from the middle.
# - false: Arrow keys behave normally in the terminal. Hints are disabled (default).
answer_mode_arrow_hints = true

# Mask context with underscores matching the exact length of the target word/phrase (true/false)
# - true: Display underscores matching the exact length of the target word (e.g. "_______" for "Absätze").
# - false: Display a fixed three-underscore mask "___" (default).
exact_length_mask = true

# Show your typed text inside the blank as you type (true/false)
# - true: While typing in the answer prompt, the current text is rendered into the blank of the context sentence in real time.
# - false: The blank shows the placeholder until you submit (default).
typing_preview = false

# Color the live preview like a Battleship board (true/false)
# - true: In the preview, characters matching the target at the right position are green (hit) and others are red (miss). Requires typing_preview = true.
# - false: The preview is shown without per-character coloring (default).
battleship_feedback = false

# Use strict case-sensitive matching for the diff display (true/false)
# - true: Capitalization errors (e.g. 'jacke' instead of 'Jacke') will be highlighted as errors in the diff (default).
# - false: Capitalization errors will be ignored in the diff.
case_sensitive_diff = true

# Ignore punctuation marks when validating answers and generating diffs (true/false)
# - true: Punctuation (commas, periods, hashtags, etc.) is ignored so you don't have to type it (default).
# - false: Punctuation must match exactly.
ignore_punctuation = true

# Use inverted colors for the diff output (true/false)
# - true: Invert the background and foreground colors in the diff representation.
# - false: Only change the text color (default).
diff_inverted_colors = true

# Use inverted background colors for the live typing preview (true/false)
# - true: Characters in the live preview are shown with inverted background colors.
# - false: Characters in the live preview are shown using standard bold colored text (default).
preview_inverted_colors = false

# Separate grading from input (Anki-style manual grading) (true/false)
# - true: Pressing Enter reveals the back side/diff, then you choose Again (1) or Good (3) to grade.
# - false: Automatically grades based on whether the typed answer matches the target (default).
anki_grading = true

# Count repeated cards into statistics and progress (true/false)
# - true: When repeating a card (e.g. using 's'), the answer is counted towards your score and progress.
# - false: Repeated cards do not affect your score or progress (default).
repeat_counts_in_stats = false

# Enable MPV integration (true/false)
# - true: Enable sync to and from the mpv player.
# - false: Disable mpv integration features (default).
mpv_integration = true

# Auto-play/unpause the video in MPV when syncing/pressing 'y' (true/false)
# - true: Automatically unpause and start playing the video when syncing (default).
# - false: Only seek/load the video but do not change the pause state.
mpv_play_on_sync = true

# MPV command or executable name/path (e.g. mpv, or full path to mpv.exe)
# Used when spawning the media player.
mpv_cmd = mpv

# Path to the MPV IPC server named pipe/socket
# - Windows Named Pipe (e.g. \\.\pipe\mpv-socket)
# - Unix socket path (e.g. /tmp/mpv-socket)
mpv_pipe_path = \\.\pipe\mpv-socket

# Path to the reverse IPC named pipe/socket hosted by input_helper.py
# - Windows Named Pipe (e.g. \\.\pipe\kardenwort-quiz)
# - Unix socket path (e.g. /tmp/kardenwort-quiz)
quiz_pipe_path = \\.\pipe\kardenwort-quiz

# Python command or executable name/path (e.g., python, py, or full path to virtual env)
# Used when spawning background subprocesses.
python_cmd = python

